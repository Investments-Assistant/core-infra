# Copy this file to <env>.tfvars, for example prod.tfvars, and fill in real values.
# *.tfvars files are gitignored — never commit secrets.

# ── Organization ──────────────────────────────────────────────────────────────

github_organization_email       = "your-email@example.com"
github_organization_name        = "Investments-Assistant"
github_organization_description = "AI-powered investment assistant"

org_owners = ["your-github-username"]

# ── Repository-level secrets (available to every workflow) ────────────────────
# These are not environment-scoped — e.g. SonarCloud runs on every push.

repo_secrets = {
  SONAR_TOKEN = "sqp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
}

# ── Repository-level variables for the Raspberry Pi deploy workflow ──────────
# The deploy workflow runs on the Pi self-hosted runner. Runtime secrets such as
# broker keys stay in the Pi's .env file, not in GitHub Actions.

repo_variables = {
  # Optional. If omitted, deploy.yml uses $HOME/investments-assistant.
  PI_DEPLOY_DIR = "/home/pi/investments-assistant"
}
