# Copy this file to <env>.tfvars, for example prod.tfvars, and fill in real values.
# *.tfvars files are gitignored — never commit secrets.

# ── AWS module ────────────────────────────────────────────────────────────────
# Name of the S3 bucket that stores OpenTofu state for all stacks.
# Must be globally unique. Only required during the initial bootstrap of the
# AWS module; after the bucket exists you won't need to change this value.

tf_state_buckets_names = ["invass-core-infra-terraform-state-YYYYMMDDHHMMSS", "invass-investments-assistant-k8s-terraform-state-YYYYMMDDHHMMSS"]

# ── GitHub Actions OIDC roles ────────────────────────────────────────────────

aws_region = "eu-south-2"

github_actions_owner            = "Investments-Assistant"
github_actions_repository       = "investments-assistant-k8s"
github_actions_allowed_branches = ["main"]

github_actions_terraform_state_bucket_names = [
  "invass-investments-assistant-k8s-terraform-state-20260508003100",
]
github_actions_k8s_state_key    = "investments-k8s/terraform.tfstate"
github_actions_eks_cluster_name = "investments-assistant"
